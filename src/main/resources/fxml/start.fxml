<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.unicam.cs.mpgc.rpg129097.controller.StartController"
      fx:id="root"
      alignment="CENTER"
      spacing="15"
      prefWidth="900"
      prefHeight="600"
      stylesheets="@../css/start.css">


    <padding>
        <Insets top="170" right="20" bottom="40" left="20"/>
    </padding>

    <!-- INSERIMENTO NOME -->
    <Label text="Inserisci il tuo nome:" styleClass="label"/>

    <TextField fx:id="nomeField"
               promptText="Il tuo nome..."
               styleClass="text-field"
               prefWidth="300"
               maxWidth="300"/>

    <!-- BOTTONE INIZIA -->
    <Button fx:id="iniziaButton"
            onAction="#onInizia"
            styleClass="btn-immagine">
        <graphic>
            <ImageView fitWidth="200" preserveRatio="true">
                <Image url="@/images/sfondiPulsanti/inizia.png"/>
            </ImageView>
        </graphic>
    </Button>

</VBox>